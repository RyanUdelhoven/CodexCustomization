# Default deny: only explicitly reviewed customization sources are tracked.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/hooks.json
!/config.example.toml
!/skills/
/skills/*
!/skills/AGENTS.md
!/skills/architecture-mapper/
!/skills/code-change-verification/
!/skills/context-audit/
!/skills/coulson-ready/
!/skills/decision-recorder/
!/skills/dockerize-app/
!/skills/docs-sync/
!/skills/feature-branch/
!/skills/focused-refactor/
!/skills/handoff-writer/
!/skills/local-port-manager/
!/skills/performance-optimizer/
!/skills/post-merge-cleanup/
!/skills/react-accessibility-review/
!/skills/react-browser-verification/
!/skills/react-color-theming/
!/skills/react-component-builder/
!/skills/react-component-refactor/
!/skills/react-component-testing/
!/skills/react-data-fetching/
!/skills/react-form-workflows/
!/skills/react-performance-profiling/
!/skills/react-state-debugger/
!/skills/react-typescript-contracts/
!/skills/repository-navigation/
!/skills/research-backed-skill-builder/
!/skills/skill-deconfliction/
!/skills/software-design-review/
!/skills/test-coverage-improver/
!/skills/tool-output-summarizer/
!/scripts/
!/examples/
!/templates/
!/sounds/
/sounds/*
!/sounds/README.md
!/rules/
/rules/*
!/rules/README.md

# Secrets and generated files inside allowed directories.
**/.git
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/node_modules/
**/.venv/
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/credentials.json
**/secrets.json
**/*.sqlite*
**/*.log
