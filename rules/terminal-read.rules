# Reviewed terminal allowances and approval boundaries, 2026-11-09.
# Allow rules cover outside-sandbox requests; prompt rules can also gate sandboxed commands.
# Use the protected installed codex-read for restricted read operations.
# Preserve previously saved allowances; unlisted operations use normal approval policy.

prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["pwd"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["nl"], decision="allow")
prefix_rule(pattern=["cut"], decision="allow")
prefix_rule(pattern=["du"], decision="allow")
prefix_rule(pattern=["diff"], decision="allow")
prefix_rule(pattern=["which"], decision="allow")
prefix_rule(pattern=["command", "-v"], decision="allow")
prefix_rule(pattern=["whence", "-a"], decision="allow")
prefix_rule(pattern=["uname"], decision="allow")
prefix_rule(pattern=["sw_vers"], decision="allow")
prefix_rule(pattern=["ps", "-eo"], decision="allow")
prefix_rule(pattern=["lsof", "-nP"], decision="allow")
prefix_rule(pattern=["node", "--version"], decision="allow")
prefix_rule(pattern=["/usr/sbin/sysctl"], decision="prompt", justification="Additional sysctl operands can set values; use codex-read arm64 for the fixed read.")
prefix_rule(pattern=["sysctl"], decision="prompt", justification="Additional sysctl operands can set values; use codex-read arm64 for the fixed read.")
prefix_rule(pattern=["docker", "ps"], decision="allow")
prefix_rule(pattern=["docker", "volume", "ls"], decision="allow")
prefix_rule(pattern=["coulson", "logs"], decision="allow")
prefix_rule(pattern=["/Users/ryanudelhoven/.local/share/codex-publish/codex-read"], decision="allow")

# Policy inspection treats the command after -- as data; it never executes it.
prefix_rule(pattern=["codex", "execpolicy", "check"], decision="allow")
prefix_rule(pattern=["/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex", "execpolicy", "check"], decision="allow")
# Reviewed stdlib-only recorder copy with an isolated system-Python shebang.
# Allows varying batch IDs, limits and report paths, not arbitrary Python execution.
prefix_rule(pattern=["/Users/ryanudelhoven/.local/share/codex-publish/codex-approval-review"], decision="allow")
prefix_rule(pattern=["/Users/ryanudelhoven/.local/share/codex-publish/codex-skill-validate"], decision="allow")
prefix_rule(pattern=["/Users/ryanudelhoven/.local/share/codex-publish/codex-branch-chats"], decision="allow")
prefix_rule(pattern=["/Users/ryanudelhoven/.local/share/codex-publish/secret_check.py"], decision="allow")
prefix_rule(pattern=["/Users/ryanudelhoven/.local/share/codex-publish/codex-approval-tracker"], decision="allow", justification="Reviewed isolated approval records and review commands; local data only, no command execution.")
prefix_rule(pattern=["/Users/ryanudelhoven/.local/share/codex-publish/codex-skill-usage"], decision="allow", justification="Reviewed isolated skill-usage recorder; local markers and numeric telemetry, no command execution.")

# Unrestricted variants can execute code, write files, change services, or send requests.
prefix_rule(pattern=["find"], decision="prompt", justification="Review execution or side effects; use codex-read for supported read-only operations.")
prefix_rule(pattern=["date"], decision="prompt", justification="Review execution or side effects; use codex-read for supported read-only operations.")
prefix_rule(pattern=["unlink"], decision="prompt", justification="Review execution or side effects; use codex-read for supported read-only operations.")
prefix_rule(pattern=["chmod"], decision="prompt", justification="Review execution or side effects; use codex-read for supported read-only operations.")
prefix_rule(pattern=["docker", "run"], decision="prompt", justification="Review execution or side effects; use codex-read for supported read-only operations.")
prefix_rule(pattern=["launchctl"], decision="prompt", justification="Review execution or side effects; use codex-read for supported read-only operations.")
prefix_rule(pattern=["unzip"], decision="prompt", justification="Review execution or side effects; use codex-read for supported read-only operations.")
prefix_rule(pattern=["/usr/bin/find"], decision="prompt", justification="Review execution or side effects; use codex-read for supported read-only operations.")
prefix_rule(pattern=["/usr/bin/curl"], decision="prompt", justification="Review execution or side effects; use codex-read for supported read-only operations.")
prefix_rule(pattern=["/bin/date"], decision="prompt", justification="Review execution or side effects; use codex-read for supported read-only operations.")

# Ordinary editing, tests, formatting, searches, and interpreter calls use the sandbox.
# No general allow rule: unmatched escalation still uses the normal approval policy.
# Existing saved exceptions remain effective. Use protected helpers for broader access.

# Read-only Docker inspection with variable object names, filters, and formatting.
# No global Docker flags, execution, lifecycle, deletion, or output-file commands.
prefix_rule(pattern=["docker", "image", "ls"], decision="allow")
prefix_rule(pattern=["docker", "image", "inspect"], decision="allow")
prefix_rule(pattern=["docker", "container", "inspect"], decision="allow")
prefix_rule(pattern=["docker", "volume", "inspect"], decision="allow")
prefix_rule(pattern=["docker", "network", "ls"], decision="allow")
prefix_rule(pattern=["docker", "network", "inspect"], decision="allow")

# Reviewed native macOS inspection commands, November 11, 2026.
# Fixed system paths; no output-file, mutation, shell, or execution options.
prefix_rule(pattern=["/usr/bin/stat"], decision="allow")
prefix_rule(pattern=["/usr/bin/readlink"], decision="allow")
prefix_rule(pattern=["/usr/bin/basename"], decision="allow")
prefix_rule(pattern=["/usr/bin/dirname"], decision="allow")
prefix_rule(pattern=["/usr/bin/cmp"], decision="allow")
prefix_rule(pattern=["/usr/bin/comm"], decision="allow")
prefix_rule(pattern=["/usr/bin/id"], decision="allow")
prefix_rule(pattern=["/usr/bin/whoami"], decision="allow")
prefix_rule(pattern=["/usr/bin/groups"], decision="allow")
