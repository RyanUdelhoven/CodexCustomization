# Canonical Git policy. Raw push/branch commands prompt; use protected codex-git for publication.
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["git", "ls-files"], decision="allow")
prefix_rule(pattern=["git", "ls-remote"], decision="allow")
# Read-only object/reference inspection; arguments may vary between repositories and branches.
prefix_rule(pattern=["git", "for-each-ref"], decision="allow")
prefix_rule(pattern=["git", "show-ref"], decision="allow")
prefix_rule(pattern=["git", "ls-tree"], decision="allow")
prefix_rule(pattern=["git", "merge-base"], decision="allow")
prefix_rule(pattern=["git", "rev-list"], decision="allow")
prefix_rule(pattern=["git", "-C", "/Users/ryanudelhoven/.codex", ["for-each-ref", "show-ref", "ls-tree", "merge-base", "rev-list"]], decision="allow")
prefix_rule(pattern=["git", "-C", "/Users/ryanudelhoven/.codex/skills", ["for-each-ref", "show-ref", "ls-tree", "merge-base", "rev-list"]], decision="allow")
prefix_rule(pattern=["git", "init"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "merge"], decision="allow")
prefix_rule(pattern=["git", "switch"], decision="allow")
prefix_rule(pattern=["git", "cherry-pick"], decision="allow")
prefix_rule(pattern=["git", "config"], decision="allow")
prefix_rule(pattern=["git", "worktree", "list"], decision="allow")
prefix_rule(pattern=["git", "worktree", "add"], decision="allow")
prefix_rule(pattern=["git", "worktree", "remove"], decision="allow")
prefix_rule(pattern=["git", "remote", "show"], decision="allow")
prefix_rule(pattern=["git", "remote", "add"], decision="allow")
prefix_rule(pattern=["git", "remote", "set-url"], decision="allow")
