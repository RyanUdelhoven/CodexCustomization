#!/usr/bin/python3 -I
"""Bounded publication and live GitHub reads for verified local repositories."""
import argparse
import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import stat
import subprocess
import sys
import tempfile
import time

HOME = Path('/Users/ryanudelhoven')
REPOS = {
    'customization': (HOME / '.codex', 'CodexCustomization'),
    'mynormal': (HOME / 'development/projects/MyNormal', 'MyNormal'),
    'marketnuance': (HOME / 'development/projects/MarketNuance', 'MarketNuance'),
}
INSTALL = HOME / '.local/share/codex-publish'
ENV = {'PATH': '/usr/bin:/bin', 'HOME': str(HOME), 'GIT_TERMINAL_PROMPT': '0',
       'GIT_CONFIG_NOSYSTEM': '1', 'GIT_CONFIG_GLOBAL': '/dev/null',
       'GIT_CONFIG_COUNT': '0', 'GIT_NO_REPLACE_OBJECTS': '1'}


def read_checks_file(value):
    """Read bounded JSON data, never source code or shell syntax."""
    path = Path(value)
    if not path.is_absolute():
        raise ValueError('Checks file must be an absolute path')
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_size > 262144:
            raise ValueError('Checks file must be a regular JSON file of at most 256 KiB')
        content = os.read(descriptor, 262145)
        if len(content) > 262144:
            raise ValueError('Checks file grew beyond 256 KiB')
        checks = json.loads(content)
    finally:
        os.close(descriptor)
    if (not isinstance(checks, list) or not checks or len(checks) > 100
            or not all(isinstance(item, str) and item.strip() and len(item) <= 32768
                       and '\0' not in item for item in checks)):
        raise ValueError('Checks file must contain 1–100 nonempty command evidence strings')
    return checks


def resolve_repository(value):
    if value in REPOS:
        repo, name = REPOS[value]
        return repo, 'https://github.com/RyanUdelhoven/' + name + '.git'
    path = Path(value)
    if not path.is_absolute():
        raise ValueError('Supply a known alias or absolute repository path')
    path = path.resolve()
    if not path.is_relative_to(HOME.resolve()):
        raise ValueError('Repository must be inside the user home directory')
    # Read literal local configuration with hooks/transports disabled. Validation
    # below rejects includes and rewrites before any network or mutation.
    origin = Publisher(path, '').git('config', '--local', '--no-includes',
                                    '--get-all', 'remote.origin.url')
    if not re.fullmatch(r'https://github\.com/RyanUdelhoven/[A-Za-z0-9_][A-Za-z0-9_.-]*\.git', origin):
        raise ValueError('Origin must be one literal RyanUdelhoven GitHub HTTPS repository')
    return path, origin


def failure_kind(message):
    """Classify without retrying, exposing credentials, or changing permissions."""
    text = message.lower()
    if any(x in text for x in ('not on the allowlist', 'network access to',
                               'connect tunnel failed', 'proxy connect', 'from proxy after connect', 'response 407')):
        return 'network-policy'
    if any(x in text for x in ('authentication failed', 'bad credentials', 'http 401',
                               'could not read username', 'invalid authentication')):
        return 'authentication'
    if any(x in text for x in ("couldn’t find remote ref", "couldn't find remote ref")):
        return 'missing-ref'
    if any(x in text for x in ('repository not found', 'http 404', 'http 403', 'returned error: 403', 'returned error: 404',
                               'access denied', 'permission denied')):
        return 'authorization-or-visibility'
    if any(x in text for x in ('could not resolve', 'failed to connect', 'error connecting',
                               'timed out', 'ssl certificate', 'tls')):
        return 'connectivity'
    return 'operation-failed'


def branch_ref(value):
    # Exact heads only: no options, revisions, glob patterns, or refspec destinations.
    if (len(value) > 240 or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._/-]*', value)
            or any(x in value for x in ('..', '//', '@{'))
            or any(part.startswith('.') or part.endswith(('.', '.lock')) for part in value.split('/'))
            or value.startswith('refs/') or value.endswith('/')):
        raise ValueError('Supply one literal branch name, without refs/heads/ or a refspec')
    return 'refs/heads/' + value


def run(args, cwd, check=True):
    result = subprocess.run(args, cwd=cwd, env=ENV, text=True, capture_output=True)
    if check and result.returncode:
        message = result.stderr.strip() or result.stdout.strip() or 'Command failed'
        raise ValueError('[' + failure_kind(message) + '] ' + message)
    return result


class Publisher:
    PR_CHECK_ATTEMPTS = 7

    def __init__(self, repo, url):
        self.repo, self.url = Path(repo).resolve(), url

    def git(self, *args, check=True):
        # Override repository execution hooks, transport rewrites, and credential commands.
        return run(['/usr/bin/git', '-c', 'core.hooksPath=/dev/null', '-c', 'core.fsmonitor=false', '-c', 'submodule.recurse=false',
                    '-c', 'credential.helper=', '-c', 'credential.helper=!/usr/local/bin/gh auth git-credential',
                    '-c', 'credential.https://github.com.helper=',
                    '-c', 'credential.https://github.com.helper=!/usr/local/bin/gh auth git-credential',
                    '-c', 'http.followRedirects=false', '-c', 'http.sslVerify=true',
                    '-c', 'protocol.allow=never', '-c', 'protocol.https.allow=always',
                    '-C', str(self.repo), *args], self.repo, check).stdout.strip()

    def gh(self, *args):
        return run(['/usr/local/bin/gh', *args], self.repo).stdout.strip()

    def api(self, endpoint, method='GET', **fields):
        args = ['api', '--hostname', 'github.com', '--method', method, endpoint]
        for key, value in fields.items():
            args += ['-f', key + '=' + value]
        return json.loads(self.gh(*args))

    def contribution_identity(self, source):
        user = self.api('user')
        if user['login'].lower() != 'ryanudelhoven':
            raise ValueError('Publication requires the RyanUdelhoven GitHub account')
        # The verified account-specific noreply address needs no private-email scope.
        emails = {str(user['id']) + '+' + user['login'] + '@users.noreply.github.com'}
        if user.get('email'):
            emails.add(user['email'])
        configured = self.git('show', '-s', '--format=%ae', source)
        if configured.lower() not in {email.lower() for email in emails}:
            emails.update(row['email'] for row in self.api('user/emails') if row['verified'])
        if configured.lower() not in {email.lower() for email in emails}:
            raise ValueError('Commit email is not verified for the GitHub account; preserve history and resolve attribution')
        return user

    def publish_pr(self, branch, source, user):
        repository = self.url.removeprefix('https://github.com/').removesuffix('.git')
        endpoint = 'repos/' + repository
        config = self.api(endpoint)
        if config['default_branch'] != 'main' or not config.get('allow_merge_commit', True):
            raise ValueError('Repository must allow merge commits into default main; do not fall back to squash or direct push')
        # A changed remote tip is never overwritten, including a concurrent advance.
        feature = self.remote_tip('refs/heads/' + branch)
        expected_remote = getattr(self, 'expected_remote', None)
        if expected_remote is not None and (feature or 'absent') != expected_remote:
            raise ValueError('Remote feature changed since the frozen plan; preserve it and inspect')
        if feature and feature != source:
            if expected_remote != feature:
                raise ValueError('Remote feature tip differs; preserve it and inspect before publication')
            # A normal fast-forward only, guarded by the exact frozen remote tip.
            self.git('merge-base', '--is-ancestor', feature, source)
            self.git('push', '--porcelain', '--force-with-lease=refs/heads/' + branch + ':' + feature,
                     self.url, source + ':refs/heads/' + branch)
        if not feature:
            self.git('push', '--porcelain', '--force-with-lease=refs/heads/' + branch + ':',
                     self.url, source + ':refs/heads/' + branch)
        if self.remote_tip('refs/heads/' + branch) != source:
            raise ValueError('Remote feature changed; preserve branches and inspect')
        # Verify attribution from GitHub's commit mapping, without rewriting other authors.
        mapped = self.api(endpoint + '/commits/' + source)
        if not mapped.get('author') or mapped['author']['login'].lower() != user['login'].lower():
            raise ValueError('Feature tip is not attributed to the expected GitHub account; branch retained')
        prs = self.api(endpoint + '/pulls', head='RyanUdelhoven:' + branch, base='main', state='open')
        if len(prs) > 1:
            raise ValueError('Multiple matching pull requests; inspect before merging')
        if prs:
            pr = prs[0]
        else:
            title = self.git('log', '-1', '--format=%s', source)
            commits = self.git('log', '--format=%h %B', 'main..' + source)
            pr = self.api(endpoint + '/pulls', method='POST', head=branch, base='main',
                          title=title, body='Changes prepared and verified through the mp workflow.\n\nCommits:\n' + commits)
        number = pr['number']
        details = self.api(endpoint + '/pulls/' + str(number))
        if (details['head']['sha'] != source or details['base']['ref'] != 'main'
                or details['head']['repo']['full_name'].lower() != repository.lower()
                or details['base']['repo']['full_name'].lower() != repository.lower()
                or details.get('draft') or details['user']['login'].lower() != user['login'].lower()):
            raise ValueError('PR identity, source, destination, author, or draft status differs; inspect ' + pr['html_url'])
        for attempt in range(self.PR_CHECK_ATTEMPTS):
            state = json.loads(self.gh('pr', 'view', str(number), '--repo', repository,
                                      '--json', 'mergeStateStatus,reviewDecision,statusCheckRollup'))
            checks = state.get('statusCheckRollup') or []
            successful = {'SUCCESS', 'NEUTRAL', 'SKIPPED'}
            outcomes = [row.get('conclusion') or row.get('state') for row in checks]
            blocked_checks = any(outcome not in successful for outcome in outcomes)
            reviews_blocked = state.get('reviewDecision') in {'CHANGES_REQUESTED', 'REVIEW_REQUIRED'}
            if state.get('mergeStateStatus') == 'CLEAN' and not blocked_checks and not reviews_blocked:
                break
            terminal_failure = any(outcome in {'FAILURE', 'ERROR', 'CANCELLED', 'TIMED_OUT',
                                               'ACTION_REQUIRED', 'STARTUP_FAILURE'} for outcome in outcomes)
            if (reviews_blocked or terminal_failure or state.get('mergeStateStatus') == 'DIRTY'
                    or attempt == self.PR_CHECK_ATTEMPTS - 1):
                raise ValueError('PR checks, approvals, or mergeability are pending/blocked; branches retained: ' + pr['html_url'])
            time.sleep(5)
        result = self.api(endpoint + '/pulls/' + str(number) + '/merge', method='PUT',
                          sha=source, merge_method='merge')
        if not result.get('merged'):
            raise ValueError('GitHub did not confirm the PR merge; preserve branches: ' + pr['html_url'])
        return result['sha'], pr['html_url']

    def validate_destination(self):
        if Path(self.git('rev-parse', '--show-toplevel')).resolve() != self.repo:
            raise ValueError('Registered checkout does not match repository root')
        # URL rewriting can redirect even an explicit HTTPS destination.
        config = self.git('config', '--local', '--no-includes', '--get-regexp',
                          r'^(url\..*\.(insteadof|pushinsteadof)|include.*|credential\..*|http\..*|filter\..*|remote\..*\.(vcs|proxy|uploadpack|receivepack)|extensions\.(partialclone|worktreeconfig)|core\.(sshcommand|gitproxy|alternaterefscommand))$',
                          check=False)
        if config:
            raise ValueError('Transport rewrites, executable config, or includes require manual review')
        for args in [('remote', 'get-url', '--all', 'origin'),
                     ('remote', 'get-url', '--push', '--all', 'origin')]:
            if self.git(*args).splitlines() != [self.url]:
                raise ValueError('Origin must have exactly the registered HTTPS destination')

    def validate(self):
        self.validate_destination()
        if self.git('symbolic-ref', 'refs/remotes/origin/HEAD') != 'refs/remotes/origin/main':
            raise ValueError('Registered workflow requires origin default branch main')
        if self.git('status', '--porcelain', '--untracked-files=all'):
            raise ValueError('Working tree must be clean, including untracked files')
        gitdir = Path(self.git('rev-parse', '--absolute-git-dir'))
        if any((gitdir / name).exists() for name in
               ['MERGE_HEAD', 'CHERRY_PICK_HEAD', 'REVERT_HEAD', 'rebase-apply', 'rebase-merge']):
            raise ValueError('Finish the in-progress Git operation first')

    def remote_read(self, action, branch=None):
        """Read live state, or fetch one head; never publish or run project code."""
        ref = branch_ref(branch) if branch is not None else None
        self.validate_destination()
        result = {'repository': str(self.repo), 'destination': self.url,
                  'observed_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
                  'publication': False, 'remote_state': 'live',
                  'tracking_refs': 'unchanged; cached refs are not live evidence'}
        if action == 'remote-info':
            account = self.api('user')
            if account['login'].lower() != 'ryanudelhoven':
                raise ValueError('Read workflow requires the RyanUdelhoven GitHub account')
            repository = self.url.removeprefix('https://github.com/').removesuffix('.git')
            info = self.api('repos/' + repository)
            result.update(account=account['login'], default_branch=info['default_branch'])
        elif action == 'remote-branches':
            rows = self.git('ls-remote', '--heads', self.url).splitlines()
            heads = {}
            for row in rows:
                sha, name = row.split()
                if not re.fullmatch(r'[0-9a-f]{40}', sha) or not name.startswith('refs/heads/'):
                    raise ValueError('Unexpected live branch response')
                heads[name.removeprefix('refs/heads/')] = sha
            result['branches'] = heads
        else:
            cached = self.git('rev-parse', '--verify', 'refs/remotes/origin/' + branch,
                              check=False) or None
            if action == 'remote-tip':
                tip = self.remote_tip(ref)
                result.update(branch=branch, exists=tip is not None, tip=tip, cached_tip=cached)
            elif action == 'fetch-ref':
                # No configured refspec, pruning, tag writes, tracking updates, or maintenance.
                self.git('fetch', '--no-tags', '--no-recurse-submodules', '--no-auto-maintenance',
                         '--no-write-commit-graph', '--refmap=', self.url, ref)
                tip = self.git('rev-parse', '--verify', 'FETCH_HEAD^{commit}')
                result.update(branch=branch, tip=tip, cached_tip=cached,
                              local_effects='objects and FETCH_HEAD only; use returned tip for inspection')
            else:
                raise ValueError('Unsupported remote read operation')
        result['observed_at'] = datetime.datetime.now(datetime.timezone.utc).isoformat()
        return result

    def remote_tip(self, ref):
        rows = self.git('ls-remote', '--refs', self.url, ref).splitlines()
        if not rows:
            return None
        if len(rows) != 1 or rows[0].split()[1] != ref:
            raise ValueError('Ambiguous remote ref')
        tip = rows[0].split()[0]
        if not re.fullmatch(r'[0-9a-f]{40}', tip):
            raise ValueError('Unexpected remote object ID')
        return tip

    def tracking(self, action, branch, chat):
        args = ['/usr/bin/python3', '-I', str(INSTALL / 'branch_chats.py'), action,
                '--repo', str(self.repo), '--branch', branch]
        if action == 'register':
            args += ['--chat-id', chat, '--source', 'codex', '--host-id', 'local']
        return json.loads(run(args, self.repo).stdout)

    def receipt_path(self, branch):
        common = Path(self.git('rev-parse', '--path-format=absolute', '--git-common-dir'))
        return common / 'codex-publish' / (hashlib.sha256(branch.encode()).hexdigest() + '.json')

    def inspect(self, branch, chat):
        """Local preflight without fetches, project commands, or tracking mutations."""
        # Reject executable repository settings before inspecting commit contents.
        self.validate()
        return {
            'branch': self.git('rev-parse', '--abbrev-ref', 'HEAD'),
            'head': self.git('rev-parse', 'HEAD'),
            'feature': self.git('rev-parse', '--verify', 'refs/heads/' + branch),
            'commits': self.git('log', '--oneline', 'main..' + branch),
            'changes': self.git('diff', '--no-ext-diff', '--no-textconv', '--stat', 'main...' + branch),
            'worktrees': self.git('worktree', 'list', '--porcelain'),
            'tracking': self.tracking('inspect', branch, chat),
            'remote_state': 'not refreshed; publish checks the live destination',
            'publication_workflow': 'github-pr-merge-v1',
        }

    def register(self, branch, chat):
        self.validate()
        self.git('rev-parse', '--verify', 'refs/heads/' + branch)
        return self.tracking('register', branch, chat)

    def project_plan(self, chat, request):
        self.validate_destination()
        module = INSTALL / 'mp-command-hook.py'
        if module.is_symlink() or not module.is_file():
            raise ValueError('Install the reviewed project dispatcher first')
        hook = runpy.run_path(str(module))
        if 'extend_project' not in hook:
            raise ValueError('Installed dispatcher lacks the project cycle; install the reviewed pair')
        heads = self.remote_read('remote-branches')['branches']
        return hook['extend_project'](str(self.repo), chat, request, heads)

    def complete(self, branch, chat, request, checks):
        """Run the scoped mp handoff entirely inside the protected entry point."""
        self.validate()
        if self.git('symbolic-ref', '--short', 'HEAD') != branch:
            raise ValueError('Completion requires the requested feature branch checked out')
        # Never load the workspace dispatcher or accept a caller-selected module.
        module = INSTALL / 'mp-command-hook.py'
        if module.is_symlink() or not module.is_file():
            raise ValueError('Install the reviewed protected mp handoff dependency first')
        hook = runpy.run_path(str(module))
        return hook['complete'](str(self.repo), chat, request, checks)

    def probe(self, branch, chat, checks):
        """Exercise nested metadata access without readiness or publication."""
        self.validate()
        if self.git('symbolic-ref', '--short', 'HEAD') != branch:
            raise ValueError('Probe requires the requested feature branch checked out')
        # This uses the same nested tracker as inspect/complete, including its lock.
        tracking = self.tracking('inspect', branch, chat)
        common = Path(self.git('rev-parse', '--path-format=absolute', '--git-common-dir'))
        # A unique scratch directory cannot be mistaken for a real mp-ready record.
        # Do not create a pending request, register/close a lifecycle, or call publish.
        with tempfile.TemporaryDirectory(prefix='codex-publish-probe-', dir=common) as temporary:
            path = Path(temporary) / 'evidence.json'
            path.write_text(json.dumps(checks) + '\n')
            with path.open('a') as lock:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            if json.loads(path.read_text()) != checks:
                raise ValueError('Probe evidence round trip failed')
        return {'probe': True, 'publication': False, 'branch': branch,
                'head': self.git('rev-parse', 'HEAD'), 'checks_count': len(checks),
                'nested_tracking': 'passed', 'metadata_write_and_lock': 'passed',
                'lifecycle_id': (tracking.get('record') or {}).get('id')}

    def publish(self, branch, chat, expected_source=None, expected_remote=None):
        self.validate()
        current = self.git('symbolic-ref', '--short', 'HEAD')
        if current not in (branch, 'main'):
            raise ValueError('Checkout must be on the requested feature branch or main')
        source = self.git('rev-parse', '--verify', 'refs/heads/' + branch)
        if expected_source is not None and source != expected_source:
            raise ValueError('Feature tip differs from the verified commit; prepare again')
        self.expected_remote = expected_remote
        if expected_remote is not None:
            observed = self.remote_tip('refs/heads/' + branch)
            if (observed or 'absent') != expected_remote:
                raise ValueError('Remote feature changed since the frozen plan; preserve it and inspect')
        # Check other worktrees before any mutation; never disturb their checked-out branches.
        worktrees = self.git('worktree', 'list', '--porcelain').split('\n\n')
        for block in worktrees:
            lines = block.splitlines()
            if any(line in ('branch refs/heads/main', 'branch refs/heads/' + branch) for line in lines):
                location = next(line[9:] for line in lines if line.startswith('worktree '))
                if Path(location).resolve() != self.repo:
                    raise ValueError('A participating branch is checked out in another worktree')
        default = self.git('ls-remote', '--symref', self.url, 'HEAD')
        if 'ref: refs/heads/main\tHEAD' not in default.splitlines():
            raise ValueError('Remote default branch must be main')
        self.git('fetch', '--no-tags', self.url, 'refs/heads/main')
        remote = self.git('rev-parse', 'FETCH_HEAD')
        main = self.git('rev-parse', 'refs/heads/main')
        # A fast-forward workflow refuses divergence or unrelated local main commits.
        self.git('merge-base', '--is-ancestor', main, remote)
        if self.git('rev-list', '--count', remote + '..' + source) == '0':
            # Already-integrated branches need no empty commit, push, or duplicate PR.
            self.git('switch', 'main')
            self.git('merge', '--ff-only', remote)
            receipt = self.cleanup(branch, chat)
            receipt.update(already_integrated=True, source_preserved=True)
            self.receipt_path(branch).write_text(json.dumps(receipt, indent=2) + '\n')
            return receipt
        self.git('merge-base', '--is-ancestor', remote, source)
        # Protected checker is independent of disabled repository hooks.
        run(['/usr/bin/python3', '-I', str(INSTALL / 'secret_check.py'),
             'range', '--repo', str(self.repo), '--base', remote, '--tip', source], self.repo)
        tracking = self.tracking('register', branch, chat)
        user = self.contribution_identity(source)
        merged, pr_url = self.publish_pr(branch, source, user)
        self.git('fetch', '--no-tags', self.url, 'refs/heads/main')
        published = self.git('rev-parse', 'FETCH_HEAD')
        self.git('merge-base', '--is-ancestor', source, merged)
        self.git('merge-base', '--is-ancestor', merged, published)
        self.git('switch', 'main')
        self.git('merge', '--ff-only', published)
        if self.remote_tip('refs/heads/main') != published:
            raise ValueError('Remote moved or verification failed; preserve branches and inspect manually')
        receipt = self.remove_completed(branch, chat, source, published, tracking)
        receipt.update(pull_request=pr_url, merge_commit=merged, source_preserved=True)
        self.receipt_path(branch).write_text(json.dumps(receipt, indent=2) + '\n')
        return receipt

    def cleanup(self, branch, chat):
        """Clean an already published branch without merging or pushing main."""
        self.validate()
        if self.git('symbolic-ref', '--short', 'HEAD') != 'main':
            raise ValueError('Cleanup requires the checkout on main')
        source = self.git('rev-parse', '--verify', 'refs/heads/' + branch)
        published = self.git('rev-parse', 'refs/heads/main')
        self.git('merge-base', '--is-ancestor', source, published)
        default = self.git('ls-remote', '--symref', self.url, 'HEAD')
        if 'ref: refs/heads/main\tHEAD' not in default.splitlines():
            raise ValueError('Remote default branch must be main')
        if self.remote_tip('refs/heads/main') != published:
            raise ValueError('Local main must match published main before cleanup')
        for block in self.git('worktree', 'list', '--porcelain').split('\n\n'):
            if 'branch refs/heads/' + branch in block.splitlines():
                raise ValueError('Feature branch is checked out in another worktree')
        tracking = self.tracking('register', branch, chat)
        return self.remove_completed(branch, chat, source, published, tracking)

    def remove_completed(self, branch, chat, source, published, tracking):
        receipt = {'branch': branch, 'source': source, 'published': published, 'chat': chat,
                   'tracking': tracking, 'cleanup': []}
        remote_feature = self.remote_tip('refs/heads/' + branch)
        if remote_feature == source:
            # Lease makes deletion conditional on the exact merged tip, including concurrent updates.
            self.git('push', '--porcelain', '--force-with-lease=refs/heads/' + branch + ':' + source,
                     self.url, ':refs/heads/' + branch)
            receipt['cleanup'].append('remote feature deleted')
        elif remote_feature:
            receipt['cleanup'].append('remote feature retained: tip differs; skip archival')
        # Explicit-URL fetches leave origin/main stale. Refresh only this verified
        # cache with a compare-and-swap before Git's upstream-aware safe deletion.
        cached = self.git('rev-parse', '--verify', 'refs/remotes/origin/main', check=False)
        if cached and cached != published:
            self.git('merge-base', '--is-ancestor', cached, published)
        self.git('update-ref', 'refs/remotes/origin/main', published, cached or '0' * 40)
        self.git('branch', '-d', '--', branch)
        receipt['cleanup'].append('local feature deleted')
        path = self.receipt_path(branch)
        path.parent.mkdir(exist_ok=True)
        path.write_text(json.dumps(receipt, indent=2) + '\n')
        return receipt

    def finish(self, branch, chat):
        path = self.receipt_path(branch)
        receipt = json.loads(path.read_text())
        if receipt['branch'] != branch or receipt['chat'] != chat:
            raise ValueError('Publication receipt belongs to another branch/chat')
        current = self.tracking('inspect', branch, chat)
        if current['record']['id'] != receipt['tracking']['record']['id']:
            raise ValueError('Lifecycle changed; do not close a newer lifecycle')
        result = self.tracking('close', branch, chat)
        return {'closed': True, 'tracking': result}


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == 'plan-project':
        planner = argparse.ArgumentParser(description='Freeze live branches for an existing explicit mp request')
        planner.add_argument('action')
        planner.add_argument('repository')
        planner.add_argument('chat_id')
        planner.add_argument('--request', required=True)
        args = planner.parse_args(argv)
        if not re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', args.chat_id) or not re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', args.request):
            planner.error('Supply verified chat and request UUIDs')
        repo, url = resolve_repository(args.repository)
        print(json.dumps(Publisher(repo, url).project_plan(args.chat_id, args.request), indent=2))
        return
    if argv and argv[0] in ('remote-branches', 'remote-tip', 'fetch-ref', 'remote-info'):
        reader = argparse.ArgumentParser(description='Bounded live GitHub reads; never publication')
        reader.add_argument('action', choices=['remote-branches', 'remote-tip', 'fetch-ref', 'remote-info'])
        reader.add_argument('repository')
        if argv[0] in ('remote-tip', 'fetch-ref'):
            reader.add_argument('branch')
        args = reader.parse_args(argv)
        repo, url = resolve_repository(args.repository)
        print(json.dumps(Publisher(repo, url).remote_read(args.action, getattr(args, 'branch', None)), indent=2))
        return
    parser = argparse.ArgumentParser(description=__doc__, epilog='Live reads: remote-branches REPOSITORY; remote-tip REPOSITORY BRANCH; remote-info REPOSITORY; fetch-ref REPOSITORY BRANCH')
    parser.add_argument('action', choices=['inspect', 'register', 'publish', 'cleanup', 'finish', 'complete', 'probe'])
    parser.add_argument('repository', help='Known alias or absolute local repository path')
    parser.add_argument('branch')
    parser.add_argument('chat_id')
    parser.add_argument('--expected-source', help='Publish only this verified 40-character commit')
    parser.add_argument('--expected-remote', help='Publish only against this frozen remote SHA or absent')
    parser.add_argument('--request', help='Pending mp request UUID; complete only')
    evidence = parser.add_mutually_exclusive_group()
    evidence.add_argument('--check', action='append', default=[], help='Literal check evidence; complete/probe only, never executed')
    evidence.add_argument('--checks-file', help='Absolute JSON file containing check evidence; preferred over shell arguments')
    args = parser.parse_args(argv)
    try:
        branch_ref(args.branch)
        if args.branch in ('main', 'master'):
            raise ValueError('Primary branches are merge targets, not publication sources')
    except ValueError as error:
        parser.error(str(error))
    if not re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', args.chat_id):
        parser.error('Supply the verified Codex chat UUID')
    if args.expected_source is not None and (
            args.action != 'publish' or not re.fullmatch(r'[0-9a-f]{40}', args.expected_source)):
        parser.error('--expected-source requires publish and a full lowercase commit SHA')
    if args.expected_remote is not None and (args.action != 'publish' or not (args.expected_remote == 'absent' or re.fullmatch(r'[0-9a-f]{40}', args.expected_remote))):
        parser.error('--expected-remote requires publish and a full SHA or absent')
    if args.action == 'complete':
        if not args.request or not re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', args.request):
            parser.error('complete requires a pending mp --request UUID')
        if not args.checks_file and (not args.check or not all(check.strip() for check in args.check)):
            parser.error('complete requires actual successful --check evidence')
    elif args.request is not None or ((args.check or args.checks_file) and args.action != 'probe'):
        parser.error('--request and --check require complete')
    try:
        checks = read_checks_file(args.checks_file) if args.checks_file else args.check
        repo, url = resolve_repository(args.repository)
    except (ValueError, OSError) as error:
        parser.error(str(error))
    publisher = Publisher(repo, url)
    if args.action == 'complete':
        result = publisher.complete(args.branch, args.chat_id, args.request, checks)
    elif args.action == 'probe':
        result = publisher.probe(args.branch, args.chat_id, checks)
    elif args.action == 'publish':
        result = publisher.publish(args.branch, args.chat_id, expected_source=args.expected_source, expected_remote=args.expected_remote)
    else:
        result = getattr(publisher, args.action)(args.branch, args.chat_id)
    print(json.dumps(result, indent=2))


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, KeyError, subprocess.CalledProcessError) as error:
        sys.exit('Git action stopped; inspect current state before retrying: ' + str(error))
