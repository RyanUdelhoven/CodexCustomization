{
  "description": "Record local permission requests and play Navi Hey, with a one-in-six chance of Listen.",
  "hooks": {
    "PreModelRequest": [{"hooks": [{"type": "command", "command": "/usr/bin/python3 \"${CODEX_HOME:-$HOME/.codex}/skills/approval-review/scripts/skill_usage.py\" capture", "timeout": 5}]}],
    "PostModelRequest": [{"hooks": [{"type": "command", "command": "/usr/bin/python3 \"${CODEX_HOME:-$HOME/.codex}/skills/approval-review/scripts/skill_usage.py\" capture", "timeout": 5}]}],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CODEX_HOME:-$HOME/.codex}/scripts/approval-sound.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CODEX_HOME:-$HOME/.codex}/skills/approval-review/scripts/approval_log.py\" capture",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
