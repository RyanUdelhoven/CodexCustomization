{
  "description": "Explicit mp publication, permission/usage capture, Navi approval, and OoT completion sounds.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CODEX_HOME:-$HOME/.codex}/scripts/mp-command-hook.py\"",
            "timeout": 600,
            "statusMessage": "Finishing and publishing the feature branch"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CODEX_HOME:-$HOME/.codex}/scripts/turn-end-sound.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CODEX_HOME:-$HOME/.codex}/skills/approval-review/scripts/skill_usage.py\" capture",
            "timeout": 5
          }
        ]
      }
    ],
    "PostModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CODEX_HOME:-$HOME/.codex}/skills/approval-review/scripts/skill_usage.py\" capture",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CODEX_HOME:-$HOME/.codex}/scripts/approval-sound.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CODEX_HOME:-$HOME/.codex}/skills/approval-review/scripts/approval_log.py\" capture",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
