{
  "description": "Record local permission requests and play Navi Hey.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/afplay \"${CODEX_HOME:-$HOME/.codex}/sounds/navi-hey.mp3\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CODEX_HOME:-$HOME/.codex}/skills/approval-review/scripts/approval_log.py\" capture",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
